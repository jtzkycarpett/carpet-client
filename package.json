{
  "name": "carpet-client",
  "version": "0.8.0",
  "description": "Carpet Client \u2013 eigener Minecraft Launcher mit Fabric",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.5",
    "electron-updater": "^6.3.9",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Carpet Client",
  "build": {
    "appId": "at.carpet.client",
    "productName": "Carpet Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "jtzkycarpet",
      "repo": "carpet-client",
      "releaseType": "release"
    }
  }
}